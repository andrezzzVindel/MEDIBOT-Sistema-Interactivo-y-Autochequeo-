#include <Wire.h>
#include "MAX30105.h"
#include "heartRate.h"
#include "spo2_algorithm.h" //[cite: 1]

MAX30105 particleSensor;

// Variables para BPM (método de picos rápido y estable)
const byte RATE_SIZE = 4; 
byte rates[RATE_SIZE]; 
byte rateSpot = 0;
long lastBeat = 0; 

float beatsPerMinute = 0;
int beatAvg = 0;

// Variables para SpO2 (cálculo en segundo plano)
#define BUFFER_SIZE 100
uint32_t irBuffer[BUFFER_SIZE];
uint32_t redBuffer[BUFFER_SIZE];
int32_t bufferLength = BUFFER_SIZE;
int32_t spo2 = 0;
int8_t validSPO2 = 0;
int32_t dummyHeartRate = 0;
int8_t validDummyHR = 0;
int sampleCount = 0;

unsigned long lastPrintTime = 0;

void setup() {
  Serial.begin(115200);
  Serial.println("Iniciando Medibot - Oximetría y Pulso Calibrado...");

  // Inicializar I2C en pines 21 y 22 para ESP32
  Wire.begin(21, 22);

  // Inicializar el sensor
  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("¡No se encuentra el MAX30102! Revisa las conexiones.");
    while (1);
  }

  Serial.println("Sensor encontrado. Coloque su dedo suavemente...");
  
  particleSensor.setup(); // Configuración predeterminada
  particleSensor.setPulseAmplitudeRed(0x3F); // Amplitud para mejor rebote
  particleSensor.setPulseAmplitudeIR(0x3F);  // Amplitud para mejor rebote
}

void loop() {
  long irValue = particleSensor.getIR();
  long redValue = particleSensor.getRed();

  // Si el valor IR es bajo, indica que no hay un dedo cubriendo el sensor
  if (irValue < 50000) {
    beatAvg = 0; 
    beatsPerMinute = 0;
    spo2 = 0;
    sampleCount = 0;
    
    // Imprime mensaje de espera cada 1 segundo para no saturar el monitor
    if (millis() - lastPrintTime > 1000) {
      Serial.print("Esperando dedo... Valor IR actual: ");
      Serial.println(irValue);
      lastPrintTime = millis();
    }
  } else {
    // Dedo detectado: procesar latido con el método fluido de picos
    if (checkForBeat(irValue) == true) {
      long delta = millis() - lastBeat;
      lastBeat = millis();

      beatsPerMinute = 60 / (delta / 1000.0);

      if (beatsPerMinute < 255 && beatsPerMinute > 40) {
        rates[rateSpot++] = (byte)beatsPerMinute; 
        rateSpot %= RATE_SIZE;

        beatAvg = 0;
        for (byte x = 0 ; x < RATE_SIZE ; x++) {
          beatAvg += rates[x];
        }
        beatAvg /= RATE_SIZE;
      }
    }

    // Recolección de muestras para SpO2 en segundo plano
    if (sampleCount < BUFFER_SIZE) {
      redBuffer[sampleCount] = redValue;
      irBuffer[sampleCount] = irValue;
      sampleCount++;
    } else {
      maxim_heart_rate_and_oxygen_saturation(irBuffer, bufferLength, redBuffer, &spo2, &validSPO2, &dummyHeartRate, &validDummyHR);
      // Desplazar la mitad del búfer para mantener el cálculo continuo
      for (int i = 50; i < BUFFER_SIZE; i++) {
        redBuffer[i - 50] = redBuffer[i];
        irBuffer[i - 50] = irBuffer[i];
      }
      sampleCount = 50;
    }

    // Aplicar offset de calibración al SpO2 para alinearlo con el oxímetro comercial (-3 puntos)
    int spo2Calibrado = spo2 - 3; 

    // Actualiza la pantalla serial cada 200ms con los valores calibrados
    if (millis() - lastPrintTime > 200) {
      Serial.print("IR=");
      Serial.print(irValue);
      Serial.print(" | Red=");
      Serial.print(redValue);
      Serial.print(" | BPM=");
      Serial.print(beatsPerMinute);
      Serial.print(" | Promedio BPM=");
      Serial.print(beatAvg);
      Serial.print(" | SpO2 Calibrado=");
      if (validSPO2 == 1 && spo2Calibrado >= 50 && spo2Calibrado <= 100) {
        Serial.print(spo2Calibrado);
        Serial.println("%");
      } else {
        Serial.println("Midiendo...");
      }
      lastPrintTime = millis();
    }
  }
}
